@model ecom.EF.Product

@{
    ViewBag.Title = "Update Product";
}

<h2>Update</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <label>Name</label>
    <input type="text" name="Name" value="@Model.Name" placeholder="Name" class="form-control" />
    <br />

    <label>Price</label>
    <input type="number" name="Price" value="@Model.Price" placeholder="Price" step="0.01" class="form-control" />
    <br />

    <label>Quantity</label>
    <input type="number" name="Qty" value="@Model.Qty" placeholder="Qty" class="form-control" />
    <br />

    <label>Category</label>
    <select name="CId" class="form-control">
        <option value="">Select Category</option>
        @foreach (var c in (IEnumerable<ecom.EF.Category>)ViewBag.Categories)
        {
            <option value="@c.Id" selected="@(c.Id == Model.CId ? "selected" : null)">
                @c.Name
            </option>
        }
    </select>
    <br />

    <input type="submit" value="Update" class="btn btn-primary" />
    <a href="/Product/List" class="btn btn-secondary">Cancel</a>
</form>
