@model ecom.EF.Product

@{
    ViewBag.Title = "Create Product";
}

<h2>Create Product</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Name</label>
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Price</label>
        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
    </div>

    <div class="form-group">
        <label>Qty</label>
        @Html.TextBoxFor(m => m.Qty, new { @class = "form-control", type = "number" })
    </div>

    <div class="form-group">
        <label>Category</label>
        @Html.DropDownListFor(m => m.CId, (SelectList)ViewBag.Categories,
            "Select Category", new { @class = "form-control" })
    </div>

    <br />

    <button type="submit" class="btn btn-success">Create</button>
    <a href="/Product/List" class="btn btn-secondary">Back</a>
}
