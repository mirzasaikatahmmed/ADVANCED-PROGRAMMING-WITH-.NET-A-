@model ZeroHunger.Models.Restaurant

@{
    ViewBag.Title = "Restaurant Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Restaurant Details</h2>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Name</dt>
        <dd>@Html.DisplayFor(model => model.Name)</dd>

        <dt>Contact Person</dt>
        <dd>@Html.DisplayFor(model => model.ContactPerson)</dd>

        <dt>Contact Phone</dt>
        <dd>@Html.DisplayFor(model => model.ContactPhone)</dd>

        <dt>Email</dt>
        <dd>@Html.DisplayFor(model => model.Email)</dd>

        <dt>Address</dt>
        <dd>@Html.DisplayFor(model => model.Address)</dd>

        <dt>Created At</dt>
        <dd>@Model.CreatedAt.ToLocalTime().ToString("f")</dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
</p>
