@model IEnumerable<ZeroHunger.Models.CollectRequest>

@{
    ViewBag.Title = "Collect Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Collect Requests</h2>

<p>
    @Html.ActionLink("Create New Collect Request", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Restaurant</th>
            <th>Status</th>
            <th>Max Preserve Until</th>
            <th>Requested At</th>
            <th>Estimated Quantity</th>
            <th>Pickup Address</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => item.Title)</td>
                    <td>@(item.Restaurant != null ? item.Restaurant.Name : "")</td>
                    <td>@Html.DisplayFor(m => item.Status)</td>
                    <td>
                        @(item.MaxPreserveUntil.HasValue
                        ? item.MaxPreserveUntil.Value.ToLocalTime().ToString("g")
                        : "")
                    </td>
                    <td>@item.RequestedAt.ToLocalTime().ToString("g")</td>
                    <td>@Html.DisplayFor(m => item.EstimatedQuantity)</td>
                    <td>@Html.DisplayFor(m => item.PickupAddress)</td>
                    <td>
                        @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" }) |
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">No collect requests created yet.</td>
            </tr>
        }
    </tbody>
</table>
