@model ZeroHunger.Models.CollectRequest

@{
    ViewBag.Title = "Delete Collect Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Collect Request</h2>

<h3>Are you sure you want to delete this request?</h3>
<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Restaurant</dt>
        <dd>@(Model.Restaurant != null ? Model.Restaurant.Name : "")</dd>

        <dt>Status</dt>
        <dd>@Html.DisplayFor(m => m.Status)</dd>

        <dt>Estimated Quantity</dt>
        <dd>@Html.DisplayFor(m => m.EstimatedQuantity)</dd>

        <dt>Pickup Address</dt>
        <dd>@Html.DisplayFor(m => m.PickupAddress)</dd>

        <dt>Requested At</dt>
        <dd>@Model.RequestedAt.ToLocalTime().ToString("f")</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" />
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>
