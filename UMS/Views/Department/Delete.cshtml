@model UMS.DTOs.DepartmentDTO
@{
 ViewBag.Title = "Delete Department";
}

<h2>Delete Department</h2>

<div>
 <h4>Are you sure you want to delete this department?</h4>
 <dl class="dl-horizontal">
 <dt>Department Name</dt>
 <dd>@Html.DisplayFor(m => m.DepartmentName)</dd>
 </dl>
</div>

@using (Html.BeginForm("DeleteConfirmed", "Department", FormMethod.Post))
{
 @Html.AntiForgeryToken()
 @Html.HiddenFor(m => m.Id)

 <button type="submit" class="btn btn-danger">Delete</button>
 @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}

